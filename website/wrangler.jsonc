{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sabine-website",
  "compatibility_date": "2026-11-01",
  "routes": [{ "pattern": "sabine.rs", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
