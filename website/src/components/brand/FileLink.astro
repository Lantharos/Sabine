---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  name: string;
  file: string;
  format: string;
}

const { name, file, format, ...rest } = Astro.props;
---

<a
  href={`/brand/${file}`}
  download={file}
  aria-label={`Download ${name} as ${format}`}
  class="inline-flex h-8 shrink-0 items-center rounded-full bg-navy-900/7 px-3.5 text-[0.88rem] font-medium transition hover:bg-navy-900/12"
  {...rest}
>
  {format}
</a>
