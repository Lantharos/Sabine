---
import FileLink from "./FileLink.astro";
import Section from "./Section.astro";

const logos = [
  { name: "Logo with name", file: "sabine-wordmark-on-light", dark: false, wide: true },
  { name: "Logo with name, light", file: "sabine-wordmark-on-dark", dark: true, wide: true },
  { name: "Swallow", file: "sabine-mark-on-light", dark: false, wide: false },
  { name: "Swallow, light", file: "sabine-mark-on-dark", dark: true, wide: false },
];

const rules = [
  "Leave room around it, at least half its height on every side.",
  "Use the navy logo on light backgrounds and the light one on dark backgrounds. Over a photo, pick whichever reads better.",
  "Keep it as it is: no other colours, outlines, shadows, stretching or turning.",
  "Write the name as Sabine, with a capital S. The crate and the command are sabine, in lower case.",
];
---

<Section id="logo" title="Logo">
  <p slot="intro">
    The swallow and the name. The letters are outlines, so the logo looks the same everywhere without the font.
  </p>
  <div class="grid gap-x-6 gap-y-10 sm:grid-cols-2">
    {
      logos.map(({ name, file, dark, wide }) => (
        <figure>
          <div
            class:list={[
              "grid aspect-[16/10] place-items-center rounded-[1.25rem]",
              dark ? "bg-navy-950" : "bg-cream-200",
            ]}
          >
            <img src={`/brand/${file}.svg`} alt="" class:list={[wide ? "h-11 sm:h-13" : "h-20 sm:h-24"]} />
          </div>
          <figcaption class="mt-3 flex items-center gap-2 px-1">
            <span class="min-w-0 flex-1 truncate text-navy-700">{name}</span>
            <FileLink name={name} file={`${file}.svg`} format="SVG" />
            <FileLink name={name} file={`${file}.png`} format="PNG" />
          </figcaption>
        </figure>
      ))
    }
  </div>
  <ul class="mt-12 grid gap-x-10 gap-y-4 text-navy-700 sm:grid-cols-2">
    {
      rules.map((rule) => (
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-[0.7em] size-1.5 shrink-0 rounded-full bg-clay-600" />
          {rule}
        </li>
      ))
    }
  </ul>
</Section>
